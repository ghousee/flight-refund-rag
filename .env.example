# Copy this file to `.env` and adjust as needed. `.env` is gitignored.
#
# The repo is designed to run with ZERO API keys: Postgres/pgvector and Ollama
# both run locally via docker compose. Only set ANTHROPIC_API_KEY if you want
# to upgrade generation from the local llama3.2:3b model to Claude.

# --- PostgreSQL + pgvector (matches docker-compose.yml) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=flight_refund
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy-style URL used by langchain-postgres (psycopg3 driver).
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/flight_refund

# --- Ollama (matches docker-compose.yml) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Optional: upgrade generation to Claude ---
# If set, generation uses ChatAnthropic instead of ChatOllama.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
