# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Secrets / local config ----
.env
.env.local

# ---- AI assistant context (kept local, not published) ----
CLAUDE.md
.claude/settings.local.json

# ---- Corpus source files (reproduced via src/ingest/fetch_data.py) ----
# We do NOT commit the airline/government PDFs. The fetch script downloads
# them from official URLs so anyone can rebuild data/raw/ locally.
data/raw/*
!data/raw/.gitkeep

# ---- Model / embedding caches ----
.cache/
.huggingface/
sentence_transformers/
models/

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Airline-authored content is NEVER committed (legal/content rule) ----
# vault/airlines/ notes are generated locally by parse_pdfs.py from the airline
# PDFs in data/raw/. Only government-sourced notes (APPR, eCFR), templates, and
# code are committed. See CLAUDE.md > Legal / content rules.
vault/airlines/

# ---- Obsidian (keep the markdown notes; ignore per-user app state) ----
vault/.obsidian/
vault/.trash/

# ---- Test / eval artifacts ----
.pytest_cache/
eval/results/
