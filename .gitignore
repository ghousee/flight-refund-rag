# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Secrets / local config ----
.env
.env.local

# ---- Corpus source files (reproduced via src/ingest/fetch_data.py) ----
# We do NOT commit the airline/government PDFs. The fetch script downloads
# them from official URLs so anyone can rebuild data/raw/ locally.
data/raw/*
!data/raw/.gitkeep

# ---- Model / embedding caches ----
.cache/
.huggingface/
sentence_transformers/
models/

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Obsidian (keep notes + frontmatter, ignore per-machine workspace state) ----
vault/.obsidian/workspace*
vault/.obsidian/cache
vault/.trash/

# ---- Test / eval artifacts ----
.pytest_cache/
eval/results/
